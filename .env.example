# ---------------------------------------------------------------------------
# AIWish - copy to `.env.local` and fill in the keys you have.
# Every key is optional: providers without a key are skipped automatically
# during fallback. At least one key is required.
# ---------------------------------------------------------------------------

# Passcode gate (required). Any string. Use something long.
APP_PASSCODE=change-me-to-a-long-passcode
# Salt used to sign the session cookie. Change it (any random string).
SESSION_SECRET=change-me-too
# Set to 1 only when running behind https (Vercel does this for you).
# SECURE_COOKIES=1

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------

# Primary. Used for everything by default.
OPENAI_API_KEY=

# Backup #1 + the ONLY provider used when Private mode is ON.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Backup #2
NVIDIA_API_KEY=

# Backup #3
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Optional model overrides.
# fast = cheap/quick tier, smart = stronger tier used for hard reasoning.
# Leave blank to use the built-in defaults in lib/models.ts
# ---------------------------------------------------------------------------
OPENAI_MODEL_FAST=gpt-5.4-nano
OPENAI_MODEL_SMART=gpt-5.4-mini
GEMINI_MODEL_FAST=gemini-flash-lite-latest
GEMINI_MODEL_SMART=gemini-flash-latest
NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
NVIDIA_MODEL_SMART=meta/llama-3.1-70b-instruct
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_SMART=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Max images per message
MAX_IMAGES_PER_MESSAGE=20
# Max characters of extracted document text injected into a message
MAX_DOC_CHARS=120000

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# * APP_PASSCODE and SESSION_SECRET are required. With no passcode set, the
#   login page cannot unlock and every route redirects back to it.
# * You only need one provider key. Providers without a key are skipped during
#   fallback and reported in the UI.
# * Private mode is Gemini-only, so GEMINI_API_KEY is required to use it.
# * Vercel caps a Route Handler request body at 4.5 MB. The /api/extract and
#   /api/transcribe uploads go through route handlers, so very large files need
#   the /basic front-end, which extracts documents in the browser instead.
